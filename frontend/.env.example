# Backend API origin. Also used at build time to pull blog slugs into sitemap.xml.
VITE_API_URL=https://your-render-service.onrender.com

# Public site origin, no trailing slash. Drives canonical URLs, og:url and sitemap.xml.
# Defaults to https://portfolio-abhi-aayp.vercel.app when unset.
VITE_SITE_URL=https://portfolio-abhi-aayp.vercel.app
